ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/rowana/projects/wm-charcoal-copper/scripts/desktop-theme.py --random
